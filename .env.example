# Serica Configuration
#
# Copy this file to .env and adjust values. Every variable here has a TOML
# equivalent in serica.toml; docs/CONFIG.md is the full reference with valid
# ranges. Env vars take precedence over the TOML file.
#
# Every value below is already the default — Serica runs with none of this set.

# Server
SERICA_SERVER__HOST=127.0.0.1
SERICA_SERVER__PORT=3000
SERICA_SERVER__LOG_LEVEL=info
SERICA_SERVER__LOG_FORMAT=json
SERICA_SERVER__SHUTDOWN_DRAIN_TIMEOUT_SECONDS=10
SERICA_SERVER__RATE_LIMIT_PER_MINUTE=30
# Optional gate on /api/v1/stats (unset = open, unchanged default).
# When set, requests must carry a matching `Authorization: Bearer <key>` or
# `X-API-Key: <key>` header.
SERICA_SERVER__API_KEY=
# Caps how many /api/v1/extract + serica_extract requests may run their
# fetch+parse span concurrently (1..=16).
SERICA_SERVER__MAX_CONCURRENT_EXTRACTS=2

# Search
SERICA_SEARCH__DEFAULT_TIMEOUT_MS=4000
SERICA_SEARCH__MAX_RESULTS_PER_PAGE=20
SERICA_SEARCH__SAFE_SEARCH_DEFAULT=1

# Cache (Redis optional). Requires a binary built with the non-default
# `redis-cache` Cargo feature: without it, setting SERICA_CACHE__REDIS_URL is a
# startup error, not a silent no-op. Build with
# `cargo install serica-search --features redis-cache` (the Docker image
# already includes it). See docs/CONFIG.md.
SERICA_CACHE__TTL_SECONDS=300
# TTL for cached /api/v1/extract and serica_extract responses — separate
# from TTL_SECONDS above, since docs/article pages change far less often
# than search rankings do.
SERICA_CACHE__EXTRACT_TTL_SECONDS=3600
SERICA_CACHE__REDIS_URL=
# Redis's memory cap (maxmemory) is set on the Redis server itself (see
# docker-compose.yml), not here — a client-side setting would never apply
# to anything in this process.

# MCP
SERICA_MCP__ENABLED=true

# CORS (unset = no CORS layer; not needed for server-to-server/MCP callers).
# Only set this if Serica is called directly from browser JavaScript on
# another origin.
# SERICA_CORS__ORIGIN=https://example.com

# Extract — caps the size/shape of EXTRACTED content returned by
# /api/v1/extract and serica_extract (independent of the raw-fetch byte
# cap below). SERICA_EXTRACT__OUTPUT_FORMAT is "text" or "markdown".
SERICA_EXTRACT__MAX_CONTENT_CHARS=50000
SERICA_EXTRACT__OUTPUT_FORMAT=markdown
# Caps the raw HTML byte count read_capped_body buffers before extraction
# runs (64KB..=16MB) — a memory/DoS ceiling, not a parse-correctness limit.
SERICA_EXTRACT__MAX_RAW_BYTES=4194304
# Wall-clock budget (ms) for the full extract span, fetch through parse.
SERICA_EXTRACT__TIMEOUT_MS=30000

# Outbound proxy (unset = unproxied, the default). Search and extract are
# separate keys on purpose: search is safe to proxy freely, but extract
# fetches caller-supplied URLs, and proxying it disables the SSRF
# DNS-rebinding IP-pinning guarantee in util::ssrf — read docs/PROXY.md,
# "Outbound proxy support", before setting SERICA_PROXY__EXTRACT_URL.
# SERICA_PROXY__SEARCH_URL=http://user:pass@proxy.example.com:8080
# SERICA_PROXY__EXTRACT_URL=http://user:pass@proxy.example.com:8080

# Config File Path. Blank is treated as unset (defaults + this file apply),
# not as the literal path "". Same as passing --config <path>.
SERICA_CONFIG_FILE=
